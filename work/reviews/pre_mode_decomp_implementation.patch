diff --git a/docs/07_TESTING_CI.md b/docs/07_TESTING_CI.md
index 9efd2d29..a21bf323 100755
--- a/docs/07_TESTING_CI.md
+++ b/docs/07_TESTING_CI.md
@@ -26,3 +26,17 @@
 ## 4. CI（将来）
 - GitHub Actions等で `pytest -q` を回す前提で設計する
 - 大きなデータに依存しない “tiny dataset fixture” を用意する
+
+## 5. 静的解析・アーキテクチャ検査
+dev 依存グループ（`pyproject.toml` の `[dependency-groups].dev`）に 4 ツールを入れている。`uv sync` で入る。
+
+| ツール | 見るもの | コマンド |
+|---|---|---|
+| Ruff | バグ候補、例外の握りつぶし、複雑度 | `uv run ruff check .` |
+| pyrefly | 型（基底クラスの契約、None 取り扱い） | `uv run pyrefly check` |
+| radon | 循環的複雑度（C 以下を表示）、保守性指標 | `uv run radon cc src` / `uv run radon mi src` |
+| import-linter | 層構造と計算単位の独立性（契約は `[tool.importlinter]`） | `cd src && uv run lint-imports --config ../pyproject.toml` |
+
+- import-linter は `src/` から実行する。リポジトリ直下の `mode_decomp_ml/`（互換 shim）が `src/mode_decomp_ml` を隠すため。
+- 契約の意図：`processes` → `mode_decomp_ml` の一方向、計算単位（decomposer / codec / model）同士は `base`・`*_shared`・`*_utils` 経由でのみ共有、計算層は matplotlib / Hydra / YAML / Optuna に依存しない。
+- 現状は違反が残っている（詳細は `work/reviews/2026-09-25_architecture_review.md`）。CI のゲートにする場合は、違反を解消してから該当ツールを必須化する。
diff --git a/pyproject.toml b/pyproject.toml
index 9c1b6c7c..ca2e2b3f 100755
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -36,3 +36,166 @@ where = ["src"]
 
 [tool.pytest.ini_options]
 testpaths = ["tests"]
+
+[tool.uv.extra-build-dependencies]
+# modred (optional `pod` extra) ships only an sdist whose setup.py imports
+# pkg_resources, which was removed from recent setuptools releases.
+modred = ["setuptools<81"]
+
+[dependency-groups]
+dev = [
+    "import-linter>=2.5.2",
+    "pyrefly>=1.3.1",
+    "radon>=6.0.1",
+    "ruff>=0.16.9",
+]
+
+# ---------------------------------------------------------------------------
+# Static analysis / architecture checks (dev group).
+#   uv run ruff check .                 # lint (bugs, swallowed errors, complexity)
+#   uv run pyrefly check                # type check
+#   uv run radon cc src                 # cyclomatic complexity (grade C or worse + average)
+#   uv run radon mi src                 # maintainability index
+#   cd src && uv run lint-imports --config ../pyproject.toml
+#       # architecture contracts; run from src/ because the repo-root
+#       # mode_decomp_ml/ shim would otherwise shadow src/mode_decomp_ml
+# ---------------------------------------------------------------------------
+
+[tool.ruff]
+target-version = "py39"
+line-length = 120
+src = ["src", "tests"]
+extend-exclude = ["tools/_legacy"]
+
+[tool.ruff.lint]
+# Explicit list (Ruff 0.16 widened its implicit defaults): pyflakes/pycodestyle
+# errors plus rules tied to the architecture review.
+select = [
+    "E4", "E7", "E9", "F",  # pycodestyle errors + pyflakes
+    "B",        # bugbear: likely bugs
+    "BLE",      # blind `except Exception`
+    "S110",     # try/except/pass (silent failure, docs/00 invariant 9)
+    "S112",     # try/except/continue
+    "C90",      # McCabe complexity
+    "PLR0911",  # too many return statements
+    "PLR0912",  # too many branches
+    "PLR0913",  # too many arguments
+    "PLR0915",  # too many statements
+]
+
+[tool.ruff.lint.mccabe]
+max-complexity = 15
+
+[tool.ruff.lint.pylint]
+max-args = 8
+max-branches = 15
+max-returns = 8
+max-statements = 60
+
+[tool.ruff.lint.per-file-ignores]
+"tests/**" = ["PLR0913", "PLR0915"]
+
+[tool.pyrefly]
+project-includes = ["src"]
+search-path = ["src"]
+
+[tool.radon]
+exclude = "tools/_legacy/*"
+cc_min = "C"
+show_complexity = true
+total_average = true
+show_mi = true
+
+[tool.importlinter]
+root_packages = ["mode_decomp_ml", "processes"]
+include_external_packages = true
+exclude_type_checking_imports = true
+
+[[tool.importlinter.contracts]]
+id = "app-over-lib"
+name = "processes (orchestration) depends on mode_decomp_ml, never the reverse"
+type = "layers"
+layers = [
+    "processes",
+    "mode_decomp_ml",
+]
+
+[[tool.importlinter.contracts]]
+id = "lib-layers"
+name = "mode_decomp_ml layers: entrypoints > run services > compute units > registry > data > domain > kernel"
+type = "layers"
+layers = [
+    "mode_decomp_ml.run",
+    "mode_decomp_ml.cli",
+    "mode_decomp_ml.tracking",
+    "mode_decomp_ml.pipeline",
+    "mode_decomp_ml.evaluate | mode_decomp_ml.viz",
+    "mode_decomp_ml.coeff_post | mode_decomp_ml.models",  # deprecated shims
+    "mode_decomp_ml.plugins.decomposers | mode_decomp_ml.plugins.codecs | mode_decomp_ml.plugins.coeff_post | mode_decomp_ml.plugins.models | mode_decomp_ml.preprocess",
+    "mode_decomp_ml.plugins.registry",
+    "mode_decomp_ml.data",
+    "mode_decomp_ml.domain",
+    "mode_decomp_ml.config | mode_decomp_ml.optional | mode_decomp_ml.pickle_compat",
+]
+
+[[tool.importlinter.contracts]]
+id = "decomposers-independent"
+name = "Each decomposer is an independent unit; sharing goes through base / *_shared / *_utils"
+type = "layers"
+containers = ["mode_decomp_ml.plugins.decomposers"]
+layers = [
+    "annular_zernike | autoencoder | dict_learning | disk_slepian | fft2_lowpass | fft_dct | fourier_bessel | fourier_jacobi | gappy_graph_fourier | gappy_pod | graph_fourier | helmholtz | helmholtz_poisson | laplace_beltrami | offset_residual | pod | pod_em | pod_joint | pod_joint_em | pod_svd | polar_fft | pseudo_zernike | pswf2d_tensor | rbf_expansion | spherical_harmonics | spherical_slepian | wavelet2d | zernike_decomposer",
+    "zernike_shared | pod_utils",
+    "base",
+]
+
+[[tool.importlinter.contracts]]
+id = "codecs-layered"
+name = "Codecs: auto dispatcher > composite pack > leaf packs > basic"
+type = "layers"
+containers = ["mode_decomp_ml.plugins.codecs"]
+layers = [
+    "auto",
+    "offset_residual_pack",
+    "fft_complex | sh_pack | slepian_pack | tensor_pack | wavelet_pack | zernike_pack",
+    "basic",
+]
+
+[[tool.importlinter.contracts]]
+id = "models-independent"
+name = "Regressor implementations are independent; sharing goes through base"
+type = "layers"
+containers = ["mode_decomp_ml.plugins.models"]
+layers = [
+    "gbdt | mtgp | sklearn",
+    "base",
+]
+
+[[tool.importlinter.contracts]]
+id = "process-stages-independent"
+name = "Process stages are independent; only processes.pipeline composes them"
+type = "layers"
+layers = [
+    "processes.pipeline",
+    "processes.decomposition | processes.preprocessing | processes.train | processes.inference | processes.leaderboard | processes.doctor",
+    "processes._decomposition_plots | processes._decomposition_metrics",
+]
+
+[[tool.importlinter.contracts]]
+id = "compute-no-frameworks"
+name = "Compute units stay free of plotting / config / tuning frameworks"
+type = "forbidden"
+source_modules = [
+    "mode_decomp_ml.plugins",
+    "mode_decomp_ml.preprocess",
+    "mode_decomp_ml.domain",
+    "mode_decomp_ml.data",
+    "mode_decomp_ml.evaluate",
+]
+forbidden_modules = [
+    "matplotlib",
+    "hydra",
+    "omegaconf",
+    "optuna",
+    "yaml",
+]
