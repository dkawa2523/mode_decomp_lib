+def _assert_cv_candidate(transport, name, settings, split, fits):
+    result = transport.results[name]
+    payload = read_json(result.artifacts["candidate_result"])
+    analysis = read_json(result.artifacts["analysis_summary"])
+    folds = read_json(result.artifacts["cv_folds"])["folds"]
+    trials = pd.read_csv(result.tables["search_trials"])
+    assert result.extra["metric_scope"] == "inner_cv"
+    assert payload["metric_scope"] == "inner_cv"
+    assert payload["search"]["settings"] == settings
+    assert analysis["cv"] == settings["cv"]
+    assert analysis["trial_budget"] == 2
+    assert len(folds) == 3
+    assert trials.trial.tolist() == [0, 1]
+    assert trials.status.tolist() == ["ok", "ok"]
+    assert np.isfinite(trials.field_rmse).all()
+    candidate_id = payload["candidate_id"]
+    trial_configs = [json.loads(value) for value in trials.configuration]
+    assert {item["regression"]["params"]["alpha"] for item in trial_configs} == set(
+        settings["search_spaces"][candidate_id]["regression.params.alpha"]
+    )
+    expected_fits = [tuple(fold["fit_ids"]) for fold in folds]
+    actual_fits = [ids for model, ids in fits if model.candidate["id"] == candidate_id]
+    assert actual_fits == expected_fits * 2
+    for fold in folds:
+        assert set(fold["fit_ids"]).isdisjoint(fold["validation_ids"])
+        assert set(fold["fit_ids"] + fold["validation_ids"]) == set(split["train_ids"])
+    assert payload["fit_ids"] == split["train_ids"]
+    assert payload["candidate"] == trial_configs[payload["search"]["best_trial"]]
+    out_of_fold = pd.read_csv(result.tables["per_sample"])
+    assert set(out_of_fold.sample_id) == set(split["train_ids"])
+    assert len(out_of_fold) == len(split["train_ids"])
+    assert out_of_fold.fold.nunique() == 3
+    assert transport.adapters[name].publications == []
+    assert {title for title, _, _ in transport.adapters[name].scalars} == {"inner_cv"}
+    return folds
+
