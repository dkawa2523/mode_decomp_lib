+def _write_field_dataset(root: Path):
+    root.mkdir()
+    conditions = np.random.default_rng(19).normal(size=(24, 2))
+    x, y = np.meshgrid(np.linspace(-1, 1, 4), np.linspace(-1, 1, 4))
+    field = conditions[:, 0, None, None] * x + conditions[:, 1, None, None] * y
+    np.save(root / "field.npy", np.stack((field, 2 * field, -field), axis=-1))
+    pd.DataFrame(
+        {
+            "sample_id": [f"field_{index:03d}" for index in range(len(field))],
+            "array_index": np.arange(len(field)),
+            "temperature": conditions[:, 0],
+            "pressure": conditions[:, 1],
+        }
+    ).to_csv(root / "samples.csv", index=False)
+    manifest = {
+        "schema": "field_dataset_v1",
+        "samples": {"path": "samples.csv"},
+        "conditions": {"format": "table", "columns": ["temperature", "pressure"]},
+        "fields": {
+            "path": "field.npy",
+            "layout": "NHWC",
+            "kind": "multichannel",
+            "components": ["x", "y", "z"],
+            "units": ["m/s"] * 3,
+        },
+        "geometry": {
+            "kind": "rectangle",
+            "axes": {axis: {"start": -1, "step": 2 / 3, "count": 4} for axis in ("x", "y")},
+        },
+    }
+    (root / "field_dataset.yaml").write_text(yaml.safe_dump(manifest), encoding="utf-8")
+
+
