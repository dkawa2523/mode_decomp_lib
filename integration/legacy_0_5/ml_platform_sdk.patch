+"""Select the registered business package at the SDK boundary."""
+
+from __future__ import annotations
+
+from ml_platform_core.contracts import PackageManifest
+from ml_platform_mode_decomp.manifest import MODE_DECOMP_MANIFEST
+from ml_platform_tabular.manifest import TABULAR_MANIFEST
+
+
+def manifest_for_task(task: str) -> PackageManifest:
+    for manifest in (TABULAR_MANIFEST, MODE_DECOMP_MANIFEST):
+        if any(item.key == task for item in manifest.tasks):
+            return manifest
+    raise ValueError(f"Unknown business task: {task!r}")
+
+
+def is_mode_task(cfg: dict) -> bool:
+    return str(cfg.get("task", "")).startswith("mode_decomp_")
+
+
+def is_inference(cfg: dict) -> bool:
+    return cfg.get("task") in {"tabular_infer", "mode_decomp_infer"}
+
+
+def run_task(cfg: dict):
+    if is_mode_task(cfg):
+        from ml_platform_mode_decomp import run_task as execute
+    else:
+        from ml_platform_tabular import run_task as execute
+    return execute(cfg)
