@@ -0,0 +1,220 @@
+"""SDK-free checks of field-model Registry resolution and editable inference handoff."""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+from ml_platform_spdml import inference_drafts, model_source_resolution
+
+
+class Artifact:
+    def __init__(self, path):
+        self.url = str(path)
+
+    def get_local_copy(self):
+        return self.url
+
+
+class Task:
+    def __init__(self, task_id, *, stage=None, status="completed", domain="mode_decomp"):
+        self.id, self.status = task_id, status
+        self.parent = "pipeline" if stage else None
+        self.project = "stages" if stage else "training"
+        self.params = {
+            "Admission/task_id": "pipeline",
+            "Release/id": "release",
+            "Release/manifest_task_id": "manifest",
+            "Workspace/key": "workspace",
+            "Workspace/pipeline_key": domain,
+            "Workspace/training_project_id": "training",
+            "Workspace/stages_project_id": "stages",
+            "Workspace/inference_project_id": "inference",
+            "Run/stage": stage,
+        }
+        self.configurations = {}
+        self.artifacts = {}
+        self.tags = ["run_type:stage" if stage else "run_type:pipeline"]
+        self.data = SimpleNamespace(comment="")
+
+    def get_parameters(self):
+        return dict(self.params)
+
+    def update_parameters(self, values):
+        self.params.update(values)
+
+    def get_configuration_object_as_dict(self, *, name):
+        return self.configurations.get(name, {})
+
+    def set_configuration_object(self, *, name, config_dict):
+        self.configurations[name] = config_dict
+
+    def get_tags(self):
+        return list(self.tags)
+
+    def set_tags(self, tags):
+        self.tags = tags
+
+    def set_comment(self, comment):
+        self.data.comment = comment
+
+    def get_output_log_web_page(self):
+        return f"https://clearml.invalid/tasks/{self.id}"
+
+    def reload(self):
+        pass
+
+
+@pytest.fixture
+def field_family(tmp_path):
+    schema = {
+        "schema_version": 1,
+        "bundle_kind": "surrogate",
+        "condition_columns": ["temperature", "pressure"],
+        "field_shape": [4, 4, 3],
+        "components": ["x", "y", "z"],
+        "field_units": ["m/s", "m/s", "m/s"],
+    }
+    path = tmp_path / "downloaded-info.json"
+    path.write_text(json.dumps({"model_sha256": "model-hash", "input_schema": schema}), encoding="utf-8")
+    source, final = Task("pipeline"), Task("final", stage="finalize_surrogate")
+    fit = Task("fit", stage="train_candidate")
+    fit.artifacts = {"model": Artifact(path), "model_info": Artifact(path)}
+    fit.params["Model Registry/model_id"] = "candidate-registry"
+    final.artifacts = {"model": Artifact(path), "model_info": Artifact(path)}
+    final.params["Model Registry/model_id"] = "final-registry"
+    source.configurations["Training stages"] = {"train_small": "fit", "finalize_surrogate": "final"}
+    tasks = {task.id: task for task in (source, fit, final)}
+
+    def clone(**kwargs):
+        draft = Task("draft", status="created")
+        draft.params = {}
+        draft.parent, draft.project = kwargs["parent"], kwargs["project"]
+        tasks[draft.id] = draft
+        return draft
+
+    api = SimpleNamespace(
+        get_task=lambda task_id: tasks[task_id],
+        get_tasks=lambda **_kwargs: [task for task in tasks.values() if task.parent == source.id],
+        clone=clone,
+    )
+    return source, fit, final, schema, api, path
+
+
+def resolve(api, *, selector="best", task="mode_decomp_infer", context=None):
+    return model_source_resolution.resolve_infer_model_source_config(
+        {
+            "task": task,
+            "model": {"source_type": "task_id", "source_task_id": "pipeline", "model_selector": selector},
+            "runtime": {"execution_context": context or {}},
+        },
+        task_cls_factory=lambda: api,
+        resolve_artifact_path=lambda url: str(url),
+        resolve_model_path=lambda model_id, *, release_id: f"download/{release_id}/{model_id}.joblib",
+    )
+
+
+def test_field_registry_resolution_uses_only_completed_finalization(field_family):
+    _, _, final, _, api, info_path = field_family
+    cfg = resolve(api)
+    assert cfg["model"]["artifact_path"] == "download/release/final-registry.joblib"
+    assert cfg["model"]["info_path"] == str(info_path)
+    assert cfg["runtime"]["execution_context"] == {
+        "source_pipeline_task_id": "pipeline",
+        "source_model_task_id": final.id,
+        "evaluation_task_id": final.id,
+        "registry_model_id": "final-registry",
+        "artifact_name": "model",
+        "model_sha256": "model-hash",
+        "source_release_id": "release",
+    }
+
+
+@pytest.mark.parametrize("selector", ["ridge", "ensemble", "ensemble:weighted"])
+def test_field_inference_rejects_tabular_model_selectors(field_family, selector):
+    with pytest.raises(ValueError, match="only model_selector=best"):
+        resolve(field_family[4], selector=selector)
+
+
+@pytest.mark.parametrize("change", ["task", "context", "source", "child"])
+def test_field_inference_rejects_cross_domain_models(field_family, change):
+    source, _, final, _, api, _ = field_family
+    task_key, context = "mode_decomp_infer", None
+    if change == "task":
+        task_key = "tabular_infer"
+    elif change == "context":
+        context = {"pipeline_key": "tabular_regression"}
+    elif change == "source":
+        source.params["Workspace/pipeline_key"] = "tabular_regression"
+    else:
+        final.params["Workspace/pipeline_key"] = "tabular_regression"
+    with pytest.raises(ValueError, match="different Pipeline domain"):
+        resolve(api, task=task_key, context=context)
+
+
+@pytest.mark.parametrize("change", ["missing", "wrong_identity", "failed", "unpublished", "no_model"])
+def test_field_resolution_requires_successful_recorded_finalization(field_family, change):
+    source, fit, final, _, api, _ = field_family
+    if change == "missing":
+        del source.configurations["Training stages"]["finalize_surrogate"]
+    elif change == "wrong_identity":
+        source.configurations["Training stages"]["finalize_surrogate"] = fit.id
+    elif change == "failed":
+        final.status = "failed"
+    elif change == "unpublished":
+        del final.params["Model Registry/model_id"]
+    else:
+        del final.artifacts["model"]
+    with pytest.raises(ValueError, match=r"Stage|completed|Model Registry"):
+        resolve(api)
+
+
+def test_field_draft_starts_empty_and_exposes_condition_schema(field_family, monkeypatch):
+    source, _, final, schema, api, _ = field_family
+    source.status = "in_progress"
+    monkeypatch.setattr(
+        inference_drafts,
+        "read_manifest",
+        lambda *_args: {"tasks": {"inference": {"task_id": "template"}}, "queues": {"stage": "field-queue"}},
+    )
+    queues, links = [], []
+    monkeypatch.setattr(inference_drafts, "set_task_queue", lambda task, queue: queues.append((task.id, queue)))
+    monkeypatch.setattr(
+        inference_drafts,
+        "_publish_handoff_links",
+        lambda _api, _source, evaluation, draft: links.append((evaluation.id, draft.id)),
+    )
+    draft = inference_drafts.prepare_initial_inference(api, source)
+    assert draft.params["Input/clearml_dataset_id"] == ""
+    assert draft.params["Input/dataset_file"] == ""
+    assert draft.params["Input/source_manifest"] == ""
+    assert json.loads(draft.params["Input/condition_columns"]) == schema["condition_columns"]
+    assert not {"Input/feature_columns", "Input/target_column", "Input/id_columns"} & draft.params.keys()
+    assert draft.params["Model/source_task_id"] == source.id
+    assert draft.params["Model/model_selector"] == "best"
+    assert draft.configurations["Input schema"] == schema
+    assert draft.configurations["Model preview"]["evaluation_task_id"] == final.id
+    assert "temperature, pressure" in draft.data.comment
+    assert "Training fields are not required" in draft.data.comment
+    assert queues == [(draft.id, "field-queue")]
+    assert links == [(final.id, draft.id)]
+    assert source.params["Origin/initial_inference_task_id"] == draft.id
+    draft.params["Input/clearml_dataset_id"] = "user-edited-data"
+    source.params["Handoff/status"] = "ready"
+    source.configurations["Run summary"] = {
+        "initial_inference_task_id": draft.id,
+        "ready_to_infer_url": draft.get_output_log_web_page(),
+    }
+    source.status = "completed"
+    assert inference_drafts.prepare_initial_inference(api, source, repair=True) is draft
+    assert draft.params["Input/clearml_dataset_id"] == "user-edited-data"
+
+
+@pytest.mark.parametrize("columns", [None, [], ["a", "a"], ["a", ""]])
+def test_invalid_field_schema_is_rejected_before_draft_creation(field_family, monkeypatch, columns):
+    source, _, _, schema, api, path = field_family
+    source.status = "in_progress"
+    schema["condition_columns"] = columns
+    path.write_text(json.dumps({"model_sha256": "model-hash", "input_schema": schema}), encoding="utf-8")
+    monkeypatch.setattr(api, "clone", lambda **_kwargs: pytest.fail("Invalid schema must not create a Draft"))
+    with pytest.raises(ValueError, match="condition column schema"):
+        inference_drafts.prepare_initial_inference(api, source)
