+def _manifest_overrides(step: DomainStepPlan, manifest: PackageManifest) -> dict[str, Any]:
+    """Translate business config paths and ArtifactRef values, without stage guesses."""
+    manifest.stage(step.stage_key)
+    specs = {spec.config_path: spec for stage in manifest.stages for spec in stage.parameters if spec.config_path}
+    output: dict[str, Any] = {}
+
+    def walk(value: Any, path: tuple[str, ...]) -> None:
+        if path in specs:
+            spec = specs[path]
+            output[spec.name] = normalize_clearml_param_value(_render_refs(value))
+        elif isinstance(value, dict):
+            for key, item in value.items():
+                walk(item, (*path, key))
+        else:
+            raise ValueError(f"Stage override is absent from the business manifest: {'.'.join(path)}")
+
+    walk(step.parameter_overrides, ())
+    return output
+
+
+def _render_refs(value: Any) -> Any:
+    if isinstance(value, ArtifactRef):
+        return _artifact_ref(value.step_name, value.artifact_name)
+    if isinstance(value, dict):
+        return {key: _render_refs(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_render_refs(item) for item in value]
+    return value
+
