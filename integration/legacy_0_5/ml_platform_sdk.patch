+@pytest.mark.parametrize("transport", [{"tuning": _TUNING_SETTINGS}], indirect=True)
+def test_tuning_json_survives_sdk_stages_and_refits_only_the_cv_winner(transport, monkeypatch):
+    # A published Stage template has no controller's search settings. Only the
+    # rendered Tuning/config parameter may deliver them to each worker here.
+    settings = transport.config.pop("tuning")
+    fitted = []
+    original_fit = FieldSurrogate.fit
+
+    def record_fit(model, dataset):
+        fitted.append((model, tuple(dataset.sample_ids)))
+        return original_fit(model, dataset)
+
+    monkeypatch.setattr(FieldSurrogate, "fit", record_fit)
+    for step in transport.plan["steps"]:
+        encoded = step["parameter_override"]["Tuning/config"]
+        assert isinstance(encoded, str)
+        assert json.loads(encoded) == settings
+        transport.execute_step(step)
+        assert transport.resolved[step["name"]]["tuning"] == settings
+    split = read_json(transport.results["prepare_fields"].artifacts["split"])
+    assert split["nested"] is False
+    assert "selection_ids" not in split
+    assert set(split["train_ids"]).isdisjoint(split["test_ids"])
+    assert len(fitted) == 2 * 2 * 3 + 1
+    assert len({id(model) for model, _ in fitted}) == len(fitted)
+    assert all(set(ids) <= set(split["train_ids"]) for _, ids in fitted)
+    first = _assert_cv_candidate(transport, "train_pod_exact", settings, split, fitted[:-1])
+    second = _assert_cv_candidate(transport, "train_pod_regularized", settings, split, fitted[:-1])
+    assert first == second
+    final = transport.results["finalize_surrogate"]
+    summary = read_json(final.artifacts["result_summary"])
+    model = load_model(final.artifacts["model"], final.artifacts["model_info"])
+    assert isinstance(model, FieldSurrogate)
+    assert summary["selection_scope"] == "inner_cv"
+    assert summary["metric_scope"] == "final_test"
+    assert summary["best_candidate"] == "pod_exact"
+    assert fitted[-1][1] == tuple(split["train_ids"])
+    assert model.candidate["regression"]["params"]["alpha"] == 0.0
+    assert list(model.fit_sample_ids) == split["train_ids"]
+    assert pd.read_csv(final.tables["per_sample"])["sample_id"].tolist() == split["test_ids"]
+    assert final.metrics["field_rmse"] < 1e-4
+    assert transport.adapters["finalize_surrogate"].publications == [
+        ("model", final.artifacts["model"], final.artifacts["model_info"])
+    ]
+    assert len(transport.models) == 1
