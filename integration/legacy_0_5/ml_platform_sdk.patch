+"""The second business package uses the same release and parameter transport."""
+
+from pathlib import Path
+
+from ml_platform_core.config import load_run_config
+from ml_platform_mode_decomp.manifest import MODE_DECOMP_MANIFEST
+from ml_platform_spdml.parameters import build_default_connected_params, native_task_fields
+from ml_platform_spdml.pipeline_controller import _validate_training_inputs
+from ml_platform_spdml.release_source import _source_path
+from ml_platform_spdml.template_spec import pipeline_definition, remote_packages
+
+
+def test_field_inference_exposes_dataset_conditions_and_pinned_model_source():
+    cfg = load_run_config("config/tasks/mode_decomp_infer.yaml", "config/profiles/clearml-dev.yaml")
+    params = build_default_connected_params(cfg, manifest=MODE_DECOMP_MANIFEST)
+    fields = {field.name for field in native_task_fields(cfg["task"], params, manifest=MODE_DECOMP_MANIFEST)}
+    assert {
+        "Input/clearml_dataset_id",
+        "Input/dataset_file",
+        "Input/source_manifest",
+        "Input/condition_columns",
+        "Model/source_task_id",
+        "Model/model_selector",
+    } <= fields
+    assert not {"Model/artifact_path", "Model/info_path", "Model/source_type", "Input/local_path"} & fields
+    assert params["Model/source_type"] == "task_id"
+    assert params["Model/model_selector"] == "best"
+    assert not any(name.startswith(("Features/", "Basic/")) for name in fields)
+
+
+def test_field_agent_installs_the_pinned_workspace_distribution_metadata():
+    third_party = remote_packages()
+    field_packages = remote_packages(install_workspace=True)
+    assert field_packages == [*third_party, "-e ./pkgs/core", "-e ./pkgs/mode_decomp"]
+    assert all("==" in item for item in third_party)
+    assert _source_path("pkgs/mode_decomp/README.md")
+    assert not _source_path("pkgs/mode_decomp/secrets/README.md")
+    for item in ("core", "mode_decomp"):
+        assert (Path("pkgs") / item / "pyproject.toml").is_file()
+
+
+def test_field_final_publication_is_a_definition_not_a_tabular_artifact_alias():
+    definition = pipeline_definition("mode_decomp")
+    assert definition.manifest is MODE_DECOMP_MANIFEST
+    assert definition.evaluation_stage == "finalize_surrogate"
+    assert definition.model_artifact == "model"
+    assert pipeline_definition().evaluation_stage == "evaluate_models"
+    assert pipeline_definition().model_artifact == "best_model"
+    _validate_training_inputs({"Input/clearml_dataset_id": "immutable-fields"}, task_key="mode_decomp_pipeline")
