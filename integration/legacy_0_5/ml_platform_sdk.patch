+def _assert_training_transport(transport):
+    steps = transport.plan["steps"]
+    assert [step["name"] for step in steps] == [
+        "prepare_fields",
+        "train_pod_exact",
+        "train_pod_regularized",
+        "finalize_surrogate",
+    ]
+    for step in steps[1:3]:
+        encoded = step["parameter_override"]["Candidate/config"]
+        assert isinstance(encoded, str)
+        assert json.loads(encoded) == transport.resolved[step["name"]]["candidate"]
+    encoded = steps[-1]["parameter_override"]["StageInputs/candidate_results"]
+    assert json.loads(encoded) == [
+        "${train_pod_exact.artifacts.candidate_result.url}",
+        "${train_pod_regularized.artifacts.candidate_result.url}",
+    ]
+    assert transport.resolved["finalize_surrogate"]["stage_inputs"]["candidate_results"] == [
+        str(transport.results[name].artifacts["candidate_result"])
+        for name in ("train_pod_exact", "train_pod_regularized")
+    ]
+    assert transport.dataset_requests == [(step["name"], "training-data", "") for step in steps]
