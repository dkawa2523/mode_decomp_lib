@@ -0,0 +1,485 @@
+"""Local numerical checks across SDK parameter and artifact transport boundaries.
+
+The recording transport replaces ClearML storage and Task calls, not the business
+workflow, parameter codec, source resolver, or Stage implementations.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import numpy as np
+import pandas as pd
+import pytest
+import yaml
+from ml_platform_core.io import read_json
+from ml_platform_core.result import RunError, RunResult
+from ml_platform_mode_decomp.manifest import MODE_DECOMP_MANIFEST
+from ml_platform_mode_decomp.model_artifact import load_model
+from ml_platform_mode_decomp.surrogate import FieldSurrogate
+from ml_platform_spdml import app, business, pipeline_plan, releases, reports
+from ml_platform_spdml.adapter import ClearMLAdapter
+from ml_platform_spdml.model_source_resolution import resolve_infer_model_source_config
+from ml_platform_spdml.parameters import build_default_connected_params
+
+_ARTIFACT_REFERENCE = re.compile(r"\$\{([^.}]+)\.artifacts\.([^.}]+)\.url\}")
+_CONTEXT_PARAMETERS = {
+    "Release/id": "field-release",
+    "Release/runtime_id": "field-runtime",
+    "Release/manifest_task_id": "release-snapshot",
+    "Workspace/pipeline_key": "mode_decomp",
+    "Workspace/key": "workspace",
+    "Workspace/training_project_id": "training-project",
+    "Workspace/stages_project_id": "stages-project",
+    "Workspace/inference_project_id": "inference-project",
+    "Admission/task_id": "pipeline",
+}
+_TUNING_SETTINGS = {
+    "enabled": True,
+    "method": "random",
+    "n_trials": 2,
+    "seed": 73,
+    "cv": {"method": "random", "n_splits": 3, "seed": 109},
+    "search_spaces": {
+        "pod_exact": {"regression.params.alpha": [0.0, 100.0]},
+        "pod_regularized": {"regression.params.alpha": [5.0, 100.0]},
+    },
+}
+
+
+class TransportTask:
+    def __init__(self, task_id: str, *, stage: str | None = None):
+        self.id, self.stage = task_id, stage
+        self.parent = "pipeline" if stage else None
+        self.status = "completed"
+        self.project = "stages-project" if stage else "training-project"
+        self.params = {**_CONTEXT_PARAMETERS, "Run/stage": stage}
+        self.artifacts: dict[str, Any] = {}
+        self.configurations: dict[str, Any] = {}
+
+    def get_parameters(self):
+        return dict(self.params)
+
+    def get_configuration_object_as_dict(self, *, name):
+        return self.configurations.get(name, {})
+
+    def get_tags(self):
+        return ["run_type:stage" if self.stage else "run_type:pipeline"]
+
+    def reload(self):
+        pass
+
+
+class RecordingAdapter(ClearMLAdapter):
+    def __init__(self, transport: RecordingTransport, task: TransportTask):
+        super().__init__(task)
+        self.transport = transport
+        self.publications: list[tuple[str, Path, Path]] = []
+        self.scalars: list[tuple[str, str, float]] = []
+        self.tables: list[tuple[str, str, Path]] = []
+
+    def resolve_dataset(self, dataset_id, fallback_local_path):
+        self.transport.dataset_requests.append((self.task.id, dataset_id, fallback_local_path))
+        return str(self.transport.datasets[dataset_id])
+
+    def resolve_artifact_path(self, artifact_path):
+        if artifact_path is None:
+            return None
+        value = str(artifact_path)
+        if "://" not in value:
+            return value
+        self.transport.downloads.append((self.task.id, value))
+        return str(self.transport.files[value])
+
+    def resolve_infer_model_source(self, cfg):
+        return resolve_infer_model_source_config(
+            cfg,
+            task_cls_factory=lambda: SimpleNamespace(get_task=lambda task_id: self.transport.tasks[task_id]),
+            resolve_artifact_path=self.resolve_artifact_path,
+            resolve_model_path=lambda model_id, *, release_id: str(self.transport.models[(release_id, model_id)]),
+        )
+
+    def upload_artifact(self, name, path):
+        path = Path(path)
+        assert path.is_file()
+        url = f"https://artifacts.invalid/{self.task.id}/{name}"
+        self.transport.files[url] = path
+        self.task.artifacts[name] = SimpleNamespace(url=url)
+
+    def publish_model(self, *, artifact_name, weights_path, info_path):
+        weights_path, info_path = Path(weights_path), Path(info_path)
+        assert weights_path.is_file()
+        assert info_path.is_file()
+        assert read_json(info_path)["model_sha256"]
+        self.publications.append((artifact_name, weights_path, info_path))
+        model_id = f"registry-{self.task.id}-{artifact_name}"
+        self.task.params[f"Model Registry/{artifact_name}_id"] = model_id
+        self.transport.models[(self.task.params["Release/id"], model_id)] = weights_path
+        return model_id
+
+    def report_scalar(self, title, series, value, iteration=0):
+        self.scalars.append((title, series, value))
+
+    def report_table(self, title, series, path, iteration=0):
+        self.tables.append((title, series, Path(path)))
+
+    def report_image(self, title, series, path, iteration=0):
+        pytest.fail(f"This transport test disables plot upload: {title}/{series}/{path}")
+
+
+class RecordingTransport:
+    def __init__(self, config: dict[str, Any], plan: dict[str, Any], datasets: dict[str, Path]):
+        self.config, self.plan, self.datasets = config, plan, datasets
+        self.files: dict[str, Path] = {}
+        self.models: dict[tuple[str, str], Path] = {}
+        self.downloads: list[tuple[str, str]] = []
+        self.dataset_requests: list[tuple[str, str, str | None]] = []
+        self.tasks = {"pipeline": TransportTask("pipeline")}
+        self.adapters: dict[str, RecordingAdapter] = {}
+        self.results: dict[str, RunResult] = {}
+        self.resolved: dict[str, dict[str, Any]] = {}
+
+    def substitute(self, value: Any) -> Any:
+        if isinstance(value, str):
+            return _ARTIFACT_REFERENCE.sub(lambda match: self.tasks[match[1]].artifacts[match[2]].url, value)
+        if isinstance(value, dict):
+            return {key: self.substitute(item) for key, item in value.items()}
+        if isinstance(value, list):
+            return [self.substitute(item) for item in value]
+        return value
+
+    def runtime_step(self, step: dict[str, Any], overrides: dict[str, Any] | None = None):
+        cfg = deepcopy(self.config)
+        cfg["task"] = "mode_decomp_stage"
+        task = TransportTask(step["name"], stage=step["parameter_override"]["Run/stage"])
+        self.tasks[task.id] = task
+        adapter = RecordingAdapter(self, task)
+        self.adapters[task.id] = adapter
+        connected = {
+            **build_default_connected_params(cfg, manifest=MODE_DECOMP_MANIFEST),
+            **self.substitute(step["parameter_override"]),
+            **(overrides or {}),
+        }
+        resolved = app._runtime_task_config(adapter, cfg, connected)
+        self.resolved[task.id] = resolved
+        return adapter, resolved
+
+    def execute_step(self, step):
+        adapter, resolved = self.runtime_step(step)
+        result = business.run_task(resolved)
+        reports.report_result(adapter, result, upload_plots=False)
+        self.results[step["name"]] = result
+        self.tasks["pipeline"].configurations["Training stages"] = {name: name for name in self.results}
+        return result
+
