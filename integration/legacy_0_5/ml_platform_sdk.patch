+def _assert_statistical_boundaries(transport):
+    prepared = transport.results["prepare_fields"]
+    split = read_json(prepared.artifacts["split"])
+    revision = split["dataset_revision"]
+    assert set(split["fit_ids"]).isdisjoint(split["selection_ids"])
+    assert set(split["train_ids"]).isdisjoint(split["test_ids"])
+    for name in ("train_pod_exact", "train_pod_regularized"):
+        result = transport.results[name]
+        payload = read_json(result.artifacts["candidate_result"])
+        assert payload["dataset_revision"] == revision
+        assert payload["fit_ids"] == split["fit_ids"]
+        assert pd.read_csv(result.tables["per_sample"])["sample_id"].tolist() == split["selection_ids"]
+        assert result.extra["model_publications"] == []
+        assert transport.adapters[name].publications == []
+    final = transport.results["finalize_surrogate"]
+    assert read_json(final.artifacts["result_summary"])["best_candidate"] == "pod_exact"
+    assert final.metrics["field_rmse"] < 1e-4
+    info = read_json(final.artifacts["model_info"])
+    assert info["provenance"]["dataset_revision"] == revision
+    assert info["provenance"]["evaluation_task_id"] == "finalize_surrogate"
+    model = load_model(final.artifacts["model"], final.artifacts["model_info"])
+    assert list(model.fit_sample_ids) == split["train_ids"]
+    assert pd.read_csv(final.tables["per_sample"])["sample_id"].tolist() == split["test_ids"]
+    assert transport.adapters["finalize_surrogate"].publications == [
+        ("model", final.artifacts["model"], final.artifacts["model_info"])
+    ]
+    assert not transport.adapters["prepare_fields"].publications
+    assert {title for title, _, _ in transport.adapters["train_pod_exact"].scalars} == {"selection_holdout"}
+    assert {title for title, _, _ in transport.adapters["finalize_surrogate"].scalars} == {"final_test"}
+    return model
