@@ -0,0 +1,117 @@
+"""Tabular policy checks, separate from common configuration syntax."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import Any
+
+from ml_platform_core.config_validation import ConfigValidationError
+from ml_platform_core.config_validation import validate_run_config as validate_common_config
+
+from .stages import as_stage_name
+
+_STRING_FIELDS = (
+    "data.target_column",
+    "split.method",
+    "split.group_column",
+    "split.time_column",
+    "split.valid_filter_column",
+    "split.valid_filter_value",
+    "features.preset",
+    "features.numeric_impute_strategy",
+    "features.categorical_impute_strategy",
+    "features.categorical_encoder",
+    "features.scaling",
+    "model.name",
+    "model.selection_metric",
+    "model.source_type",
+    "model.source_task_id",
+    "model.model_selector",
+    "model.local_model_path",
+    "model.artifact_path",
+    "model.info_path",
+)
+_LIST_FIELDS = (
+    "data.feature_columns",
+    "data.id_columns",
+    "features.drop_columns",
+    "features.passthrough_columns",
+    "model.ensemble.methods",
+)
+
+
+def validate_run_config(config: Mapping[str, Any]) -> None:
+    validate_common_config(config)
+    for section in ("split", "features", "model", "basic"):
+        _require_type(config, section, Mapping, "a mapping")
+    for path in _STRING_FIELDS:
+        _require_type(config, path, str, "a string")
+    for path in _LIST_FIELDS:
+        value = _get(config, path)
+        if value is not None and not isinstance(value, (str, list, tuple)):
+            raise ConfigValidationError(f"{path} must be a list, comma string, or null.")
+    for path in ("model.params", "model.ensemble"):
+        _require_type(config, path, Mapping, "a mapping")
+    _require_type(config, "model.ensemble.enabled", bool, "a boolean")
+    _validate_stage(config)
+    _validate_numbers(config)
+    _validate_split_method(config)
+
+
+def _validate_stage(config: Mapping[str, Any]) -> None:
+    stage = _get(config, "run.stage")
+    if stage is not None:
+        try:
+            as_stage_name(stage)
+        except ValueError as exc:
+            raise ConfigValidationError(str(exc)) from exc
+
+
+def _validate_numbers(config: Mapping[str, Any]) -> None:
+    for path in ("split.valid_size", "split.selection_size"):
+        value = _get(config, path)
+        if value is None:
+            continue
+        if isinstance(value, bool) or not isinstance(value, (int, float)):
+            raise ConfigValidationError(f"{path} must be a number or null.")
+        if not 0 < float(value) < 1:
+            raise ConfigValidationError(f"{path} must be between 0 and 1.")
+    for path in ("model.ensemble.top_k", "features.max_dense_cells"):
+        value = _get(config, path)
+        if value is None:
+            continue
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise ConfigValidationError(f"{path} must be an integer or null.")
+        if value < 1:
+            raise ConfigValidationError(f"{path} must be at least 1.")
+
+
+def _validate_split_method(config: Mapping[str, Any]) -> None:
+    method = _get(config, "split.method")
+    if method is None:
+        return
+    if method not in {"random", "group", "time", "fixed"}:
+        raise ConfigValidationError("split.method must be one of: random, group, time, fixed.")
+    required = {
+        "group": ("group_column",),
+        "time": ("time_column",),
+        "fixed": ("valid_filter_column", "valid_filter_value"),
+    }.get(method, ())
+    for key in required:
+        if _get(config, f"split.{key}") in (None, ""):
+            raise ConfigValidationError(f"split.{key} is required for split.method={method}.")
+
+
+def _require_type(config: Mapping[str, Any], path: str, expected: type, description: str) -> None:
+    value = _get(config, path)
+    if value is not None and not isinstance(value, expected):
+        raise ConfigValidationError(f"{path} must be {description} or null.")
+
+
+def _get(config: Mapping[str, Any], path: str) -> Any:
+    value: Any = config
+    for key in path.split("."):
+        if not isinstance(value, Mapping) or key not in value:
+            return None
+        value = value[key]
+    return value
