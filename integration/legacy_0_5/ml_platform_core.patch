diff --git a/tests/test_core_business_primitives.py b/tests/test_core_business_primitives.py
new file mode 100644
index 0000000..658ae92
--- /dev/null
+++ b/tests/test_core_business_primitives.py
@@ -0,0 +1,85 @@
+from __future__ import annotations
+
+import pytest
+from ml_platform_core.artifacts import file_hash, finish_run
+from ml_platform_core.config_validation import ConfigValidationError, validate_run_config
+from ml_platform_core.contracts import ArtifactRef, resolve_artifact_refs
+from ml_platform_core.io import read_json
+from ml_platform_core.model_artifact import runtime_identity, validate_model_integrity
+from ml_platform_core.result import RunResult
+from ml_platform_tabular.config_validation import validate_run_config as validate_tabular_config
+from ml_platform_tabular.stage_result import finish_stage
+
+
+def test_artifact_refs_resolve_nested_outputs_without_mutation(tmp_path):
+    model, scores, plot = (tmp_path / name for name in ("model.joblib", "scores.csv", "plot.png"))
+    result = RunResult(tmp_path, artifacts={"model": model}, tables={"scores": scores}, plots={"plot": plot})
+    refs = {
+        "model": ArtifactRef("fit", "model"),
+        "other": [ArtifactRef("fit", "scores"), (ArtifactRef("fit", "plot"), "constant")],
+    }
+    resolved = resolve_artifact_refs(refs, {"fit": result})
+    assert resolved == {"model": model, "other": [scores, (plot, "constant")]}
+    assert isinstance(refs["model"], ArtifactRef)
+
+
+def test_artifact_refs_reject_ambiguous_or_missing_outputs(tmp_path):
+    result = RunResult(tmp_path, artifacts={"same": tmp_path / "first"}, tables={"same": tmp_path / "other"})
+    with pytest.raises(ValueError, match="different paths"):
+        resolve_artifact_refs(ArtifactRef("fit", "same"), {"fit": result})
+    with pytest.raises(KeyError):
+        resolve_artifact_refs(ArtifactRef("missing", "model"), {})
+    with pytest.raises(KeyError):
+        resolve_artifact_refs(ArtifactRef("fit", "missing"), {"fit": RunResult(tmp_path)})
+
+
+def test_common_stage_syntax_has_no_tabular_membership():
+    config = {
+        "task": "mode_decomp_stage",
+        "run": {"stage": "prepare_fields"},
+        "split": {"method": "domain_specific"},
+        "model": {"candidates": []},
+    }
+    validate_run_config(config)
+    with pytest.raises(ConfigValidationError, match="Unsupported tabular stage"):
+        validate_tabular_config({**config, "task": "tabular_stage"})
+    with pytest.raises(ConfigValidationError, match="stage identifier"):
+        validate_run_config({"task": "other", "run": {"stage": "../bad"}})
+
+
+def test_finish_run_records_common_outputs_and_tabular_delegates(tmp_path):
+    output = tmp_path / "scores.csv"
+    output.write_text("score\n1\n", encoding="utf-8")
+    cfg = {"task": "business", "run": {"name": "test"}}
+    result = finish_run(
+        cfg, tmp_path, metrics={"score": 1.0}, tables={"scores": output}, extra={"metric_scope": "selection"}
+    )
+    assert result.tables == {"scores": output}
+    assert read_json(result.artifacts["manifest"])["tables"]["scores"]["sha256"] == file_hash(output)
+    assert result.extra["metric_scope"] == "selection"
+    delegated = finish_stage(cfg, tmp_path / "tabular", metrics={}, artifacts={"scores": output})
+    assert delegated.artifacts["config"].is_file()
+    assert delegated.artifacts["manifest"].is_file()
+    with pytest.raises(ValueError, match="different paths"):
+        finish_run(cfg, tmp_path / "bad", artifacts={"scores": output}, tables={"scores": tmp_path / "other"})
+
+
+def test_common_model_identity_checks_hash_runtime_and_provenance(tmp_path):
+    model = tmp_path / "model.joblib"
+    model.write_bytes(b"not-deserialized-by-this-test")
+    info = {
+        "model_sha256": file_hash(model),
+        "runtime": runtime_identity(["numpy"]),
+        "provenance": {"source_release_id": "r1", "runtime_id": "cpu"},
+    }
+    validate_model_integrity(model, info, {"source_release_id": "r1", "execution_release_id": "r1"})
+    with pytest.raises(ValueError, match="source release"):
+        validate_model_integrity(model, info, {"source_release_id": "r1", "execution_release_id": "r2"})
+    with pytest.raises(ValueError, match="runtime_id"):
+        validate_model_integrity(model, info, {"runtime_id": "other"})
+    invalid_runtime = {**info, "runtime": {"python": "0.0.0", "packages": {}}}
+    with pytest.raises(ValueError, match="Python"):
+        validate_model_integrity(model, invalid_runtime)
+    model.write_bytes(b"tampered")
+    with pytest.raises(ValueError, match="hash does not match"):
+        validate_model_integrity(model, info)
