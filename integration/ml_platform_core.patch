+def finish_run(
+    config: dict[str, Any],
+    run_dir: str | Path,
+    *,
+    metrics: dict[str, Any] | None = None,
+    artifacts: dict[str, Path] | None = None,
+    tables: dict[str, Path] | None = None,
+    plots: dict[str, Path] | None = None,
+    extra: dict[str, Any] | None = None,
+) -> RunResult:
+    """Finish common snapshot/manifest/result bookkeeping, without publication."""
+    root = Path(run_dir)
+    root.mkdir(parents=True, exist_ok=True)
+    outputs = {**(artifacts or {})}
+    config_path, manifest_path = root / "config.yaml", root / "manifest.json"
+    _merge_output_paths(outputs, tables or {}, plots or {}, {"config": config_path, "manifest": manifest_path})
+    outputs.pop("manifest", None)
+    if "config" not in outputs:
+        outputs["config"] = write_config_snapshot(config, root)
+    outputs["manifest"] = write_manifest(
+        root,
+        config=config,
+        metrics=metrics,
+        artifacts=outputs,
+        tables=tables,
+        plots=plots,
+        extra=extra,
+    )
+    return RunResult(
+        run_dir=root,
+        metrics=dict(metrics or {}),
+        artifacts=outputs,
+        tables=dict(tables or {}),
+        plots=dict(plots or {}),
+        extra=dict(extra or {}),
+    )
