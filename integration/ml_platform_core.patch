+@dataclass(frozen=True)
+class ArtifactRef:
+    """An output key on a successful predecessor, independent of transport."""
+
+    step_name: str
+    artifact_name: str
+
+    def __post_init__(self) -> None:
+        for value in (self.step_name, self.artifact_name):
+            if not isinstance(value, str) or not value.strip():
+                raise ValueError("ArtifactRef names must be non-empty strings.")
+
+
+def _merge_output_paths(*groups: Mapping[str, str | Path]) -> dict[str, Path]:
+    paths: dict[str, Path] = {}
+    for group in groups:
+        for key, value in group.items():
+            path = Path(value)
+            if key in paths and paths[key].resolve() != path.resolve():
+                raise ValueError(f"Output key {key!r} refers to different paths.")
+            paths[key] = path
+    return paths
+
+
+def resolve_artifact_refs(value: Any, results: Mapping[str, RunResult]) -> Any:
+    """Resolve references in dict/list/tuple values without mutating inputs."""
+    if isinstance(value, ArtifactRef):
+        result = results[value.step_name]
+        outputs = _merge_output_paths(result.artifacts, result.tables, result.plots)
+        return outputs[value.artifact_name]
+    if isinstance(value, dict):
+        return {key: resolve_artifact_refs(item, results) for key, item in value.items()}
+    if isinstance(value, list):
+        return [resolve_artifact_refs(item, results) for item in value]
+    if isinstance(value, tuple):
+        return tuple(resolve_artifact_refs(item, results) for item in value)
+    return value
